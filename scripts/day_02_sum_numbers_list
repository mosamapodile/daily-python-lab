
def sum_numbers(numbers:list)->int:
    total_sum = 0
    for num in numbers:
        total_sum += num
    return total_sum

def main():
    print('*'*45)
    print('welcome to the sum calculator , give me a list eg: [1,2,3] for sum')
    print('*'*45)
    
    list_ = list(int(input('enter list, eg: 1, 2, 3, etc.. : ')))
    result = sum_numbers(list_)
    return result

if __name__ == "__main__":
    main()